# .npmrc — настройки npm для проекта
# Зачем: фиксирует поведение npm, чтобы lockfile оставался стабильным
# между разными средами (Mac, Linux CI, Docker).

# При npm install сохранять в lockfile с префиксом ~ (только patch-обновления)
save-prefix=~

# Использовать только зафиксированные версии (не '^')
# ^ в package.json автоматически заменяется на ~
package-lock=true

# Обходить peer dependency conflicts (eslint 9 vs 10 и т.п.)
legacy-peer-deps=true

# В CI/Docker добавлять --include=optional явно в workflow.
# Не ставим omit=optional здесь потому что nuxt prepare требует
# native bindings (oxc-parser, sharp, rolldown).

# Минимизировать вывод в CI
fund=false
audit=false
update-notifier=false
